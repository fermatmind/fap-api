{"asset_id":"candidate_content_method_boundary_v0_5_13","asset_key":"candidate.method_boundary.retest_frequency_and_trend.v0_5","asset_version":"v0_5","asset_type":"method_boundary","asset_layer":"L0_governance","module_key":"module_10_method_privacy","section_key":"method_privacy","slot_key":"module_10_method_privacy.method.retest_method","copy_role":"user_visible_method_boundary_candidate","reading_mode":["standard","deep"],"title_zh":"复测看趋势，不刷结果","body_zh":"复测的价值不是追求更好看的结果，也不是证明自己彻底变成另一种人。更有意义的做法是间隔一段时间，在相对稳定的状态下重新作答，并把两次结果和真实行为记录放在一起看。反复出现的倾向可能更稳定；只在某段压力或环境中出现的变化，更适合作为阶段性线索。过于频繁的复测容易放大当下情绪、记忆和作答习惯。","short_body_zh":"人格有稳定性，但生活阶段、压力和自我管理会影响具体表现。","cta_zh":"复测前记录三件事：近期压力、协作变化、一个想验证的行为倾向。","applies_to":{"scale_code":["BIG5_OCEAN"],"candidate_stage":["method_boundary_v0_5_normalized"],"target_registry_key":["method_registry"],"target_module":["module_10_method_privacy"],"selection_scope":["retest_method_boundary"],"candidate_replaces":["asset.module_10_method_privacy.method_registry.retest_method.v0_3"],"original_reading_modes":["standard","deep"]},"avoid_when":[{"field":"runtime_use","operator":"not_equals","value":"staging_only","action":"block_runtime_use"},{"field":"production_use_allowed","operator":"not_equals","value":false,"action":"block_production_use"}],"can_combine_with":["method_registry"],"cannot_combine_with":["runtime_use","production_use","frontend_copy"],"dedupe_group":"method_boundary_v0_5.module_10_method_privacy.method.retest_method","selection_priority":82,"selection_specificity":10,"fallback_allowed":false,"render_surface":[],"body_quality":{"body_chars":144,"sentence_count":4,"max_sentence_length":47,"has_method_layer":false,"has_boundary_layer":true,"has_action_layer":true,"has_privacy_layer":false,"has_editorial_leakage":false,"recalculated_by":"codex_method_boundary_scientific_repair_01"},"safety_tags":["method_boundary","human_reviewed_candidate","staging_only","not_runtime","no_frontend_copy","no_production_use"],"qa_status":"safety_revi