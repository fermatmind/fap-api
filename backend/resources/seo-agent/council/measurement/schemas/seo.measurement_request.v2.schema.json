{
  "schema_id": "seo.measurement_request.v2",
  "schema_version": "2.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "mission_id", "run_id", "role_id", "mode_id", "page_family", "locale", "windows", "evidence_bundle_refs", "authority_revision", "execution_allowed", "request_hash"],
  "properties": {
    "version": {"const": "seo.measurement_request.v2"},
    "mission_id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"},
    "run_id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"},
    "role_id": {"enum": ["seo.expert.search_analytics_measurement", "seo.expert.commercial_funnel_cro"]},
    "mode_id": {"enum": ["search_measurement", "commercial_funnel_cro"]},
    "page_family": {"enum": ["tests", "articles_topics", "career", "personality", "trust_method_help", "other_public"]},
    "locale": {"enum": ["en", "zh-CN"]}, "windows": {"const": [7, 28, 90]},
    "evidence_bundle_refs": {"type": "array", "minItems": 1, "maxItems": 2, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["bundle_id", "bundle_version", "bundle_hash", "source_type", "authority_type"],
      "properties": {
        "bundle_id": {"type": "string"}, "bundle_version": {"const": 2},
        "bundle_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "source_type": {"enum": ["gsc_aggregate", "public_funnel_aggregate"]},
        "authority_type": {"const": "measurement_readmodel"}
      }
    }},
    "authority_revision": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "execution_allowed": {"const": false}, "request_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
