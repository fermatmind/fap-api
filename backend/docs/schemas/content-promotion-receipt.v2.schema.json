{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fermatmind.com/schemas/content-promotion-receipt.v2.schema.json",
  "title": "FermatMind exact-package content promotion receipt V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_kind",
    "result",
    "phase",
    "adapter",
    "lane",
    "subscope",
    "source_repository",
    "source_commit",
    "package_path",
    "package_sha256",
    "executor_release_sha256",
    "release_policy_sha256",
    "workflow_run_id",
    "workflow_run_attempt",
    "idempotency_key",
    "expected_count",
    "written_count",
    "readback_count",
    "published_count",
    "previous_receipt_sha256",
    "rollback_reference",
    "locale_check",
    "cjk_leakage_check",
    "identity_check",
    "privacy_redaction",
    "private_payload_read_count",
    "server_topology_exposed",
    "indexability_mutation_count",
    "sitemap_mutation_count",
    "llms_mutation_count",
    "search_mutation_count",
    "deploy_mutation_count",
    "receipt_content_sha256"
  ],
  "properties": {
    "schema_version": { "const": "fermatmind.content_promotion_receipt.v2" },
    "receipt_kind": { "enum": ["content_promotion_preflight_receipt", "cms_draft_import_receipt", "cms_publication_receipt", "cms_live_qa_receipt"] },
    "result": { "const": "SUCCEEDED" },
    "phase": { "enum": ["preflight", "draft-import", "publish", "live-qa"] },
    "adapter": { "type": "string", "pattern": "^[a-z0-9_]{1,96}$" },
    "lane": { "type": "string", "pattern": "^W[1-8]$" },
    "subscope": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "source_repository": { "const": "fermatmind/fap-api" },
    "source_commit": { "$ref": "#/$defs/sha1" },
    "package_path": { "type": "string", "pattern": "^(content_assets/en-content-parity|content_packs|content_baselines|database/seeders/data)/" },
    "package_sha256": { "$ref": "#/$defs/sha256" },
    "executor_release_sha256": { "$ref": "#/$defs/sha256" },
    "release_policy_sha256": { "$ref": "#/$defs/sha256" },
    "workflow_run_id": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
    "workflow_run_attempt": { "type": "integer", "minimum": 1 },
    "idempotency_key": { "$ref": "#/$defs/sha256" },
    "expected_count": { "type": "integer", "minimum": 1 },
    "written_count": { "type": "integer", "minimum": 0 },
    "readback_count": { "type": "integer", "minimum": 1 },
    "published_count": { "type": "integer", "minimum": 0 },
    "previous_receipt_sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "rollback_reference": { "type": ["string", "null"], "maxLength": 255 },
    "locale_check": { "const": "PASS" },
    "cjk_leakage_check": { "const": "PASS" },
    "identity_check": { "const": "PASS" },
    "privacy_redaction": { "const": true },
    "private_payload_read_count": { "const": 0 },
    "server_topology_exposed": { "const": false },
    "indexability_mutation_count": { "const": 0 },
    "sitemap_mutation_count": { "const": 0 },
    "llms_mutation_count": { "const": 0 },
    "search_mutation_count": { "const": 0 },
    "deploy_mutation_count": { "const": 0 },
    "receipt_content_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
