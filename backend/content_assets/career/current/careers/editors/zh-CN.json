          "id": "editors.profile.onet-structured-fields-block.1",
          "source_refs": [
            "onet-details"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.career-quick-answers-block",
          "data": {
            "paragraphs": [
              "高质量交付让每项重要修改、来源、未决问题和审批状态可追溯。"
            ]
          },
          "id": "editors.profile.career-quick-answers-block.1",
          "source_refs": [
            "onet-details"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.career-quick-answers-block",
