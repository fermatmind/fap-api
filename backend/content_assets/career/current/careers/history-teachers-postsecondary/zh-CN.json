          "data": {
            "paragraphs": [
              "交付一页证据表，分开原文、计算、解释、限制和下一步来源。"
            ]
          },
          "id": "history-teachers-postsecondary.path.career-path-block.7",
          "source_refs": [
            "editorial-history-guidance"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.career-path-block",
          "data": {
            "paragraphs": [
              "成长看更可靠的课程设计、史料核验、评价反馈、研究与指导证据，不承诺固定年限或职位。"
            ]
