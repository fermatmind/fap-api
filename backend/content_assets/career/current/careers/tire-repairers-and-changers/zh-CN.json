      "id": "profile",
      "items": [
        {
          "availability": "available",
          "copy_key": "career.item.definition-block",
          "data": {
            "paragraphs": [
              "本页覆盖O*NET 49-3093.00轮胎修理与更换工。"
            ]
          },
          "id": "tire-repairers-and-changers.profile.definition-block.1",
          "source_refs": [
            "onet-details"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.definition-block",
          "data": {
            "paragraphs": [
              "投入包括工单、车辆身份、轮胎与轮辋信息、损伤证据和作业条件。"
            ]
          },
          "id": "tire-repairers-and-changers.profile.definition-block.2",
          "source_refs": [
            "editorial-tire"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.definition-block",
          "data": {
            "paragraphs": [
              "产出包括检查记录、修理或更换结果、平衡与复核记录及交接。"
            ]
          },
          "id": "tire-repairers-and-changers.profile.definition-block.3",
          "source_refs": [
            "onet-details"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.definition-block",
          "data": {
            "paragraphs": [
              "流程从确认对象与工单开始，经检查、判断、执行、复核、记录和交接。"
            ]
          },
          "id": "tire-repairers-and-changers.profile.definition-block.4",
          "source_refs": [
            "editorial-tire"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.definition-block",
          "data": {
            "paragraphs": [
              "关键判断包括规格是否匹配、损伤是否超出可处理范围以及信息是否充分。"
            ]
          },
          "id": "tire-repairers-and-changers.profile.definition-block.5",
          "source_refs": [
            "editorial-tire"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.definition-block",
          "data": {
            "paragraphs": [
              "O*NET任务资料包括检查轮胎、拆装轮胎、修理轮胎与维护作业记录。"
            ]
          },
          "id": "tire-repairers-and-changers.profile.definition-block.6",
          "source_refs": [
            "onet-details"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.definition-block",
          "data": {
            "paragraphs": [
              "工作会接触车辆部件、轮胎、工具、设备和服务记录。"
            ]
          },
          "id": "tire-repairers-and-changers.profile.definition-block.7",
          "source_refs": [
            "onet-details"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.definition-block",
          "data": {
            "paragraphs": [
              "常见协作对象包括客户、调度、同事、主管和零件库存人员。"
            ]
          },
          "id": "tire-repairers-and-changers.profile.definition-block.8",
          "source_refs": [
            "editorial-tire"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.definition-block",
          "data": {
            "paragraphs": [
              "质量看对象一致、判断有依据、记录可追溯且交接清楚。"
            ]
          },
          "id": "tire-repairers-and-changers.profile.definition-block.9",
          "source_refs": [
            "editorial-tire"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.definition-block",
          "data": {
            "paragraphs": [
              "NHTSA消费者资料涉及胎压、胎面、老化和损伤检查，但不能替代具体维修判断。"
            ]
          },
          "id": "tire-repairers-and-changers.profile.definition-block.10",
          "source_refs": [
            "nhtsa-tire"
          ],
          "type": "prose"
        }
      ]
