  "blocks": [
    {
      "availability": "available",
      "content_state": "enhanced",
      "copy_key": "career.block.quick-decision",
      "id": "quick-decision",
      "items": [
        {
          "availability": "available",
          "copy_key": "career.item.fermat-decision-card",
          "data": {
            "paragraphs": [
              "直接判断：核心是在医师指导下准确衔接接诊、记录、检查准备、预约和收费信息。"
            ]
          },
          "id": "medical-assistants.quick-decision.fermat-decision-card.1",
          "source_refs": [
            "onet-details"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.fermat-decision-card",
          "data": {
            "paragraphs": [
              "登记姓名、出生日期等信息时，应比较各处原值；字段空白或不一致时原样保留并交给执业人员。"
            ]
          },
          "id": "medical-assistants.quick-decision.fermat-decision-card.2",
          "source_refs": [
            "editorial-medical-guidance"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.fermat-decision-card",
          "data": {
            "paragraphs": [
              "安全体验只使用MA-4虚构登记记录，不接触真实患者或执行临床操作。"
            ]
          },
          "id": "medical-assistants.quick-decision.fermat-decision-card.3",
          "source_refs": [
            "editorial-medical-guidance"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.fermat-decision-card",
          "data": {
            "paragraphs": [
              "输出身份差异、缺失字段、暂缓项目和复核对象。"
            ]
          },
          "id": "medical-assistants.quick-decision.fermat-decision-card.4",
          "source_refs": [
            "editorial-medical-guidance"
          ],
          "type": "prose"
        }
      ]
    },
    {
      "availability": "available",
      "content_state": "enhanced",
      "copy_key": "career.block.profile",
      "id": "profile",
      "items": [
        {
          "availability": "available",
          "copy_key": "career.item.definition-block",
          "data": {
            "paragraphs": [
              "本页覆盖美国O*NET 31-9092.00医疗助理精确职业，不包括医师助理、注册护士或执业护士。"
            ]
          },
          "id": "medical-assistants.profile.definition-block.1",
          "source_refs": [
            "onet-details"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.definition-block",
          "data": {
            "paragraphs": [
              "投入包括预约信息、患者身份、病史、生命体征、医师指示、标本和保险资料。"
            ]
          },
          "id": "medical-assistants.profile.definition-block.2",
          "source_refs": [
            "onet-details"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.definition-block",
          "data": {
            "paragraphs": [
              "产出包括更新后的记录、检查准备、预约与收费信息、标本日志和异常交接。"
            ]
          },
          "id": "medical-assistants.profile.definition-block.3",
          "source_refs": [
            "onet-details"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.definition-block",
          "data": {
            "paragraphs": [
              "流程从身份核对开始，经信息采集、记录、准备、获授权任务和交接。"
            ]
          },
          "id": "medical-assistants.profile.definition-block.4",
          "source_refs": [
            "onet-details"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.definition-block",
          "data": {
            "paragraphs": [
              "关键判断是身份是否一致、字段是否完整、指示与权限是否清楚。"
            ]
          },
          "id": "medical-assistants.profile.definition-block.5",
          "source_refs": [
            "onet-details"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.definition-block",
          "data": {
            "paragraphs": [
              "工作常在诊所、医师办公室、医院或门诊机构，行政与患者接触任务可能交替。"
            ]
          },
          "id": "medical-assistants.profile.definition-block.6",
          "source_refs": [
            "onet-details"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.definition-block",
          "data": {
            "paragraphs": [
              "常见对象包括电子病历、预约与收费表单、生命体征设备、诊室用品和标本标签。"
            ]
          },
          "id": "medical-assistants.profile.definition-block.7",
          "source_refs": [
            "onet-details"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.definition-block",
          "data": {
            "paragraphs": [
              "协作对象包括患者、医师、护士、实验室、收费和前台人员。"
            ]
          },
          "id": "medical-assistants.profile.definition-block.8",
          "source_refs": [
            "onet-details"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.definition-block",
          "data": {
            "paragraphs": [
              "质量看身份一致、记录准确、时间与单位清楚、隐私受控和交接可追溯。"
            ]
          },
          "id": "medical-assistants.profile.definition-block.9",
          "source_refs": [
            "editorial-medical-guidance"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.definition-block",
          "data": {
            "paragraphs": [
              "诊断、治疗决定、独立临床判断和超出授权的操作不属于本页练习。"
            ]
          },
          "id": "medical-assistants.profile.definition-block.10",
          "source_refs": [
            "editorial-medical-guidance"
          ],
          "type": "prose"
        }
      ]
    },
