          "id": "electromechanical-equipment-assemblers.path.career-path-block.6",
          "source_refs": [
            "editorial"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.career-path-block",
          "data": {
            "paragraphs": [
              "课程和岗位名称不授予带电测试、校准签发、改图或隔离解除权限。"
            ]
          },
          "id": "electromechanical-equipment-assemblers.path.career-path-block.7",
          "source_refs": [
            "editorial"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.career-path-block",
          "data": {
            "paragraphs": [
