{
  "schema_id": "seo.technical_diagnosis_request.v2",
  "schema_version": "2.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["diagnosis_id", "diagnosis_version", "mission_id", "run_id", "role_id", "mode_id", "page_family", "locale", "evidence_bundle_refs", "dependency_snapshot_ref", "detector_registry_ref", "url_truth_revision", "runtime_revision", "deployment_revision", "authority_revision", "requested_scope", "requested_at", "execution_allowed", "allow_delegation", "request_hash"],
  "properties": {
    "diagnosis_id": {"type": "string", "minLength": 1},
    "diagnosis_version": {"const": 2},
    "mission_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "role_id": {"const": "seo.expert.technical_search_authority"},
    "mode_id": {"const": "technical_search_diagnosis"},
    "page_family": {"enum": ["tests", "articles_topics", "career", "personality", "trust_method_help", "other_public"]},
    "locale": {"enum": ["zh-CN", "en"]},
    "evidence_bundle_refs": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["bundle_id", "bundle_version", "bundle_hash", "source_type", "authority_type"], "properties": {"bundle_id": {"type": "string", "minLength": 1}, "bundle_version": {"type": "integer", "minimum": 1}, "bundle_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "source_type": {"type": "string", "minLength": 1}, "authority_type": {"type": "string", "minLength": 1}}}},
    "dependency_snapshot_ref": {"type": "object", "additionalProperties": false, "required": ["snapshot_id", "snapshot_version", "snapshot_hash", "production_sha", "environment"], "properties": {"snapshot_id": {"type": "string", "minLength": 1}, "snapshot_version": {"type": "string", "minLength": 1}, "snapshot_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "production_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "environment": {"enum": ["ci_candidate", "staging_runtime", "production_runtime"]}}},
    "detector_registry_ref": {"type": "object", "additionalProperties": false, "required": ["registry_version", "registry_hash"], "properties": {"registry_version": {"type": "string", "minLength": 1}, "registry_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "url_truth_revision": {"type": "string", "minLength": 1},
    "runtime_revision": {"type": "string", "minLength": 1},
    "deployment_revision": {"type": "string", "minLength": 1},
    "authority_revision": {"type": "string", "minLength": 1},
    "requested_scope": {"type": "object", "additionalProperties": false, "required": ["sanitized_public_refs", "max_urls", "page_family", "locale"], "properties": {"sanitized_public_refs": {"type": "array"}, "max_urls": {"type": "integer", "minimum": 1, "maximum": 32}, "page_family": {"type": "string", "minLength": 1}, "locale": {"type": "string", "minLength": 1}}},
    "requested_at": {"type": "string", "minLength": 1},
    "execution_allowed": {"const": false},
    "allow_delegation": {"const": false},
    "request_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
