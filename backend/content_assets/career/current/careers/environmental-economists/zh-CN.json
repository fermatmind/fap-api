      "copy_key": "career.block.quick-decision",
      "id": "quick-decision",
      "items": [
        {
          "availability": "available",
          "copy_key": "career.item.fermat-decision-card",
          "data": {
            "paragraphs": [
              "核心是把环境问题转成成本、收益、激励与影响的可检验比较。"
            ]
          },
          "id": "environmental-economists.quick-decision.fermat-decision-card.1",
          "source_refs": [
            "onet-summary"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.fermat-decision-card",
          "data": {
            "paragraphs": [
              "数据单位、基准和假设必须保留，不能只给一个模型数字。"
            ]
          },
          "id": "environmental-economists.quick-decision.fermat-decision-card.2",
          "source_refs": [
            "editorial-env-econ"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.fermat-decision-card",
          "data": {
            "paragraphs": [
              "安全体验使用EE-3虚构方案，不接触真实项目、企业或政策决定。"
            ]
          },
          "id": "environmental-economists.quick-decision.fermat-decision-card.3",
          "source_refs": [
            "editorial-env-econ"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.fermat-decision-card",
          "data": {
            "paragraphs": [
              "输出计算表、可支持结论、限制与缺失信息。"
            ]
          },
          "id": "environmental-economists.quick-decision.fermat-decision-card.4",
          "source_refs": [
            "editorial-env-econ"
          ],
          "type": "prose"
        }
      ]
    },
    {
      "availability": "available",
      "content_state": "enhanced",
      "copy_key": "career.block.profile",
      "id": "profile",
      "items": [
        {
          "availability": "available",
          "copy_key": "career.item.definition-block",
          "data": {
            "paragraphs": [
              "本页覆盖美国O*NET 19-3011.01环境经济学家精确职业。"
            ]
          },
          "id": "environmental-economists.profile.definition-block.1",
          "source_refs": [
            "onet-summary"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.definition-block",
          "data": {
            "paragraphs": [
              "投入包括环境目标、资源数据、政策方案、成本、行为反应和时间范围。"
            ]
          },
          "id": "environmental-economists.profile.definition-block.2",
          "source_refs": [
            "onet-summary"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.definition-block",
          "data": {
            "paragraphs": [
              "产出包括经济模型、成本收益比较、预测、报告和政策建议。"
            ]
          },
          "id": "environmental-economists.profile.definition-block.3",
          "source_refs": [
            "onet-summary"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.definition-block",
          "data": {
            "paragraphs": [
              "流程从定义问题和基准开始，经收集数据、设定假设、建模、敏感性检查和沟通。"
            ]
          },
          "id": "environmental-economists.profile.definition-block.4",
          "source_refs": [
            "onet-summary"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.definition-block",
          "data": {
            "paragraphs": [
              "关键判断是数据是否适用、因果解释是否成立、结果对假设是否敏感。"
            ]
          },
          "id": "environmental-economists.profile.definition-block.5",
          "source_refs": [
            "onet-summary"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.definition-block",
          "data": {
            "paragraphs": [
              "研究对象可涉及水、空气、土地、能源、污染控制和资源保护。"
            ]
          },
          "id": "environmental-economists.profile.definition-block.6",
          "source_refs": [
            "onet-summary"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.definition-block",
          "data": {
            "paragraphs": [
              "常用方法包括经济原则、统计分析、预测与情景比较。"
            ]
          },
          "id": "environmental-economists.profile.definition-block.7",
          "source_refs": [
            "onet-summary"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.definition-block",
          "data": {
            "paragraphs": [
              "协作对象包括环境科学、统计、政策、政府、企业和社区利益相关者。"
            ]
          },
          "id": "environmental-economists.profile.definition-block.8",
          "source_refs": [
            "onet-summary"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.definition-block",
          "data": {
            "paragraphs": [
              "质量看来源可追、单位一致、假设可见、计算可复算和限制清楚。"
            ]
          },
          "id": "environmental-economists.profile.definition-block.9",
          "source_refs": [
            "onet-summary"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.definition-block",
          "data": {
            "paragraphs": [
              "最终政策、投资或监管决定不由本页练习代替。"
            ]
          },
          "id": "environmental-economists.profile.definition-block.10",
          "source_refs": [
            "editorial-env-econ"
          ],
          "type": "prose"
        }
      ]
    },
