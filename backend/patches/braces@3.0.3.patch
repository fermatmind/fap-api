diff --git a/lib/depth.js b/lib/depth.js
new file mode 100644
index 0000000000000000000000000000000000000000..1d92fd7709fd280135455ef8edfb1b54e0b25710
--- /dev/null
+++ b/lib/depth.js
@@ -0,0 +1,37 @@
+'use strict';
+
+const MAX_DEPTH = 128;
+
+const assertDepth = depth => {
+  if (depth > MAX_DEPTH) {
+    const error = new SyntaxError(`AST nesting depth exceeds maximum of ${MAX_DEPTH}`);
+    error.code = 'BRACES_MAX_DEPTH_EXCEEDED';
+    throw error;
+  }
+};
+
+const assertAstDepth = ast => {
+  const pending = [{ node: ast, depth: ast && ast.type === 'root' ? 0 : 1 }];
+
+  while (pending.length > 0) {
+    const { node, depth } = pending.pop();
+    if (!node) continue;
+    // Parser text values are strings. Arrays would reach expansion's recursive flatten.
+    if (Array.isArray(node.value)) {
+      throw new TypeError('AST text values must not be arrays');
+    }
+    if (!node.nodes) continue;
+    assertDepth(depth);
+    // Do not consume single-use/custom iterators before the public walker uses them.
+    // Each walker also enforces this bound while consuming its actual representation.
+    const repeatable = Array.isArray(node.nodes)
+      ? node.nodes[Symbol.iterator] === Array.prototype[Symbol.iterator]
+      : node.nodes instanceof Set && node.nodes[Symbol.iterator] === Set.prototype[Symbol.iterator];
+    if (!repeatable) continue;
+    for (const child of node.nodes) {
+      pending.push({ node: child, depth: child && child.nodes ? depth + 1 : depth });
+    }
+  }
+};
+
+module.exports = { assertDepth, assertAstDepth };
