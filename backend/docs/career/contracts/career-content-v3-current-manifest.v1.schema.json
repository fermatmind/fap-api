{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "career-content-v3-current-manifest.v1.schema.json",
  "additionalProperties": false,
  "properties": {
    "identity_scopes": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scope_type",
          "occupations",
          "source_route_sha256"
        ],
        "properties": {
          "scope_type": {
            "enum": [
              "exact_official_occupation",
              "bounded_official_combination"
            ]
          },
          "source_route_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "occupations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "code",
                "title"
              ],
              "properties": {
                "code": {
                  "type": "string",
                  "pattern": "^[0-9]{2}-[0-9]{4}\\.[0-9]{2}$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "identity_aliases": {
      "description": "Historical URL slugs outside the fixed 1046 Current identities only; targets must be Current slugs. O*NET/SOC sharing never creates aliases.",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
      "additionalProperties": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "aggregate_sha256": { "$ref": "#/$defs/hash" },
    "authority_path": { "const": "backend/content_assets/career/current" },
    "compiler_version": { "const": "career.content_v3.per_page.compiler.v1" },
    "contract_version": { "const": "career.content_v3_current.manifest.v1" },
    "coverage": {
      "additionalProperties": false,
      "properties": {
        "enhanced_locale_pages": { "type": "integer", "minimum": 0, "maximum": 3138 }, "files": { "const": 3138 },
        "legacy_locale_pages": { "type": "integer", "minimum": 0, "maximum": 3138 }, "locale_pages": { "const": 3138 },
        "locales": { "const": 3 }, "slugs": { "const": 1046 }
      },
      "required": ["slugs", "locales", "locale_pages", "files", "enhanced_locale_pages", "legacy_locale_pages"],
      "type": "object"
    },
    "files": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "bytes": { "minimum": 1, "type": "integer" },
          "body_qualification": {
            "additionalProperties": false,
            "properties": {
              "version": { "const": "career.public_body.v1" },
              "source_content_sha256": { "$ref": "#/$defs/hash" },
              "has_public_body": { "type": "boolean" }
            },
            "required": ["version", "source_content_sha256", "has_public_body"],
            "type": "object"
          },
          "canonical_slug": { "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "type": "string" },
          "locale": { "enum": ["en", "zh-CN", "zh-TW"] },
          "path": { "pattern": "^careers/[a-z0-9]+(?:-[a-z0-9]+)*/(?:en|zh-CN|zh-TW)\\.json$", "type": "string" },
          "sha256": { "$ref": "#/$defs/hash" },
          "source_content_sha256": { "$ref": "#/$defs/hash" }
        },
        "required": ["body_qualification", "bytes", "canonical_slug", "locale", "path", "sha256", "source_content_sha256"],
        "type": "object"
      },
      "maxItems": 3138, "minItems": 3138, "type": "array"
    },
    "locales": { "const": ["en", "zh-CN", "zh-TW"] },
    "schema_version": { "const": "career.detail.content.v3" },
    "set_hashes": {
      "additionalProperties": false,
      "properties": {
        "locale_page_set_sha256": { "$ref": "#/$defs/hash" },
        "slug_set_sha256": { "$ref": "#/$defs/hash" },
        "source_semantic_aggregate_sha256": { "$ref": "#/$defs/hash" }
      },
      "required": ["locale_page_set_sha256", "slug_set_sha256", "source_semantic_aggregate_sha256"],
      "type": "object"
    },
    "source_registry_sha256": { "$ref": "#/$defs/hash" }
  },
  "required": ["aggregate_sha256", "authority_path", "compiler_version", "contract_version", "coverage", "files", "locales", "schema_version", "set_hashes", "source_registry_sha256"],
  "type": "object",
  "$defs": { "hash": { "pattern": "^[a-f0-9]{64}$", "type": "string" } }
}
