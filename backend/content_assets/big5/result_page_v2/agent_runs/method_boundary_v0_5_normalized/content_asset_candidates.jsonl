{"asset_id":"candidate_content_method_boundary_v0_5_05","asset_key":"candidate.method_boundary.facet_domain_mismatch_reading.v0_5","asset_version":"v0_5","asset_type":"method_boundary","asset_layer":"L0_governance","module_key":"module_10_method_privacy","section_key":"method_privacy","slot_key":"module_10_method_privacy.method.facet_method","copy_role":"user_visible_method_boundary_candidate","reading_mode":["standard","deep"],"title_zh":"总维度和局部面向可能不同步","body_zh":"人格特质不是整齐的方块。一个人在某个大维度上整体偏稳定，但条理、责任感、目标推进、持续性和谨慎决策并不一定同时突出。大维度像总览图，细分面向像局部放大镜。两者不一致时，不必急着判定矛盾；更稳妥的读法是先保留大维度方向，再用细分面向寻找具体场景里的差异。单个局部信号不应推翻整份报告，整体分数也不应掩盖局部特点。","short_body_zh":"大维度和细分面向不一致时，先把它当作场景差异来理解。","cta_zh":"把不一致的地方当成提问：它更常出现在工作、关系、压力还是自我管理中？","applies_to":{"scale_code":["BIG5_OCEAN"],"candidate_stage":["method_boundary_v0_5_normalized"],"target_registry_key":["method_registry"],"target_module":["module_10_method_privacy"],"selection_scope":["facet_domain_mismatch_reading"],"candidate_replaces":["asset.module_10_method_privacy.method_registry.facet_method.v0_3"],"original_reading_modes":["standard","deep"]},"avoid_when":[{"field":"runtime_use","operator":"not_equals","value":"staging_only","action":"block_runtime_use"},{"field":"production_use_allowed","operator":"not_equals","value":false,"action":"block_production_use"}],"can_combine_with":["method_registry"],"cannot_combine_with":["runtime_use","production_use","frontend_copy"],"dedupe_group":"method_boundary_v0_5.module_10_method_privacy.method.facet_method","selection_priority":90,"selection_specificity":10,"fallback_allowed":false,"render_surface":[],"body_quality":{"body_chars":155,"sentence_count":5,"max_sentence_length":48,"has_method_layer":true,"has_boundary_layer":true,"has_action_layer":true,"has_privacy_layer":false,"has_editorial_leakage":false,"recalculated_by":"codex_method_boundary_scientific_repair_01"},"safety_tags":["method_boundary","human_reviewed_candidate","staging_only","not_runtime","no_frontend_copy","no_production_use"],"q