        {
          "availability": "available",
          "copy_key": "career.item.ai-impact-table",
          "data": {
            "paragraphs": [
              "采用条件：自动增益或降噪只可作为初始建议，不能跳过现场监听。"
            ]
          },
          "id": "audio-and-video-technicians.ai-impact.ai-impact-table.2",
          "source_refs": [
            "av-editorial"
          ],
          "type": "prose"
