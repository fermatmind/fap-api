{
  "schema_id": "seo.evidence_bundle",
  "schema_version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "seo.evidence_bundle.v1" },
    "bundle_id": { "type": "string", "minLength": 1 },
    "bundle_version": { "type": "integer", "minimum": 1 },
    "bundle_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "mission_id": { "type": "string", "minLength": 1 },
    "source_type": { "type": "string", "minLength": 1 },
    "source_ref": { "type": "string", "minLength": 1 },
    "authority_type": { "type": "string", "minLength": 1 },
    "captured_at": { "type": "string", "format": "date-time" },
    "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "evidence_state": { "enum": ["verified", "observed", "inferred", "unknown", "blocked"] },
    "freshness_state": { "enum": ["fresh", "stale", "expired", "unknown"] },
    "source_capability_state": { "enum": ["available", "degraded", "unavailable", "held"] },
    "retention_class": { "type": "string", "minLength": 1 },
    "retention_policy_version": { "type": "string", "minLength": 1 },
    "retention_policy_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "expires_at": { "type": "string", "format": "date-time" },
    "page_family": { "type": "string", "minLength": 1 },
    "locale": { "type": "string", "minLength": 2 },
    "authority_revision": { "type": "string", "minLength": 1 },
    "private_data_present": { "const": false },
    "redaction_summary": { "type": "object" },
    "injection_scan_result": { "const": "pass" },
    "source_license_class": { "type": "string", "minLength": 1 },
    "data_usage_purpose": { "type": "string", "minLength": 1 },
    "egress_decision": { "enum": ["not_required", "allowed_by_gateway", "denied", "held"] },
    "lineage_refs": { "type": "array", "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "uniqueItems": true },
    "payload": { "type": ["object", "array"] }
  },
  "required": ["schema_version", "bundle_id", "bundle_version", "bundle_hash", "mission_id", "source_type", "source_ref", "authority_type", "captured_at", "content_hash", "evidence_state", "freshness_state", "source_capability_state", "retention_class", "retention_policy_version", "retention_policy_hash", "expires_at", "page_family", "locale", "authority_revision", "private_data_present", "redaction_summary", "injection_scan_result", "source_license_class", "data_usage_purpose", "egress_decision", "lineage_refs", "payload"]
}
