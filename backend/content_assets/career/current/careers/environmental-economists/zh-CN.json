      "items": [
        {
          "availability": "available",
          "copy_key": "career.item.ai-impact-table",
          "data": {
            "paragraphs": [
              "数字工具可协助整理公开数据、执行既定计算和生成图表草稿。"
            ]
          },
          "id": "environmental-economists.ai-impact.ai-impact-table.1",
          "source_refs": [
            "editorial-env-econ"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.ai-impact-table",
          "data": {
            "paragraphs": [
              "输入数据的来源、单位、时间范围和缺失值须人工核对。"
            ]
          },
          "id": "environmental-economists.ai-impact.ai-impact-table.2",
          "source_refs": [
            "editorial-env-econ"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.ai-impact-table",
          "data": {
            "paragraphs": [
              "工具生成的关系不能自动解释为因果。"
            ]
          },
          "id": "environmental-economists.ai-impact.ai-impact-table.3",
          "source_refs": [
            "editorial-env-econ"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.ai-impact-table",
          "data": {
            "paragraphs": [
              "模型假设、折现和情景选择由分析人员说明。"
            ]
          },
          "id": "environmental-economists.ai-impact.ai-impact-table.4",
          "source_refs": [
            "editorial-env-econ"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.ai-impact-table",
          "data": {
            "paragraphs": [
              "异常结果须追回数据与公式，不靠工具猜测。"
            ]
          },
          "id": "environmental-economists.ai-impact.ai-impact-table.5",
          "source_refs": [
            "editorial-env-econ"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.ai-impact-table",
          "data": {
            "paragraphs": [
              "敏感性分析应展示关键假设变化后的结果。"
            ]
          },
          "id": "environmental-economists.ai-impact.ai-impact-table.6",
          "source_refs": [
            "editorial-env-econ"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.ai-impact-table",
          "data": {
            "paragraphs": [
              "最终建议要区分事实、模型结果和价值判断。"
            ]
          },
          "id": "environmental-economists.ai-impact.ai-impact-table.7",
          "source_refs": [
            "editorial-env-econ"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.ai-impact-table",
          "data": {
            "paragraphs": [
              "任务辅助能力不能直接推出岗位增减。"
            ]
          },
          "id": "environmental-economists.ai-impact.ai-impact-table.8",
          "source_refs": [
            "editorial-env-econ"
          ],
          "type": "prose"
        }
      ]
