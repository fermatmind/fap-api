                "PASS",
                "FAIL",
                "HOLD",
                "MEASUREMENT_HOLD",
                "INCONCLUSIVE",
                "RESTART_REQUIRED"
            ],
            "hold_rules": [
                "external data unavailable => MEASUREMENT_HOLD; denominator remains frozen"
