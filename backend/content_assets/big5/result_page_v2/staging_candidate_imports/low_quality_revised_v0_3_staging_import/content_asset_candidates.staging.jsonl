{"applies_to":{"quality_status":["low_confidence","invalid","insufficient"],"scale_code":["BIG5_OCEAN"],"scope":["low_quality"]},"asset_id":"candidate_content_low_quality_retest_recommended_context_v0_3","asset_key":"low_quality_state.retest_recommended_context.v0_3","asset_kind":"content_asset","asset_layer":"L7_result_state","asset_type":"result_state","asset_version":"v0_3","avoid_when":[{"action":"suppress","field":"scale_code","operator":"not_equals","value":"BIG5_OCEAN"},{"action":"suppress","field":"scope","operator":"not_equals","value":"low_quality"}],"body_quality":{"body_chars":191,"cta_chars":16,"has_action_layer":true,"has_boundary_layer":true,"has_editorial_leakage":false,"has_quality_layer":true,"has_retest_layer":true,"has_state_layer":true,"conditional_low_quality_only":true,"normal_result_suppression_required":true,"max_sentence_length":60,"recalculated_by":"codex_low_quality_scientific_repair_01","rendered_preview_required":true,"sentence_count":6,"short_body_chars":24,"summary_chars":25,"template_risk":"low"},"body_zh":"重新作答可放在几种情况之后：你答得很赶，中途被打断，近期状态和长期状态差异很大，或者看完结果后发现很多描述都难以对应现实。重答的目的不是获得更好看的报告，而是让系统拥有更连贯的材料。建议不要在情绪很满、时间很碎或被外界持续打扰时重答。更好的方式，是留出一段完整时间，只按近期和长期都能解释的经验作答。重答前也可以先写下近期最典型的三个场景。这样重答更像补充证据，而不是追求某个结果。","can_combine_with":["method_boundary_context","retest_guidance","safe_summary_context"],"cannot_combine_with":["strong_personality_claim","private_result_details","ranking_claim","high_stakes_language"],"copy_role":"conditional_degraded_state_user_visible_body_candidate","cta_zh":"留出完整时间，再按真实经验重答。","dedupe_group":"low_quality_state.retest_recommended_context","fallback_allowed":false,"module_key":"module_10_method_privacy","production_use_allowed":false,"qa_status":"editorial_reviewed","reading_mode":["quick","standard","deep"],"ready_for_pilot":false,"ready_for_production":false,"ready_for_runtime":false,"render_surface":["result_page","pdf"],"repair_log_refs":[],"runtime_use":"staging_only","safety_level":"degraded","safety_tags":["degrade