{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fermatmind.com/schemas/career.content_agent.release_handoff.v1.schema.json",
  "title": "Career Content Agent release-authority handoff v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "release_authority", "request_hash", "content_agent_receipt_sha256", "module", "publication_slugs"],
  "properties": {
    "contract_version": {"const": "career.content_agent.release_handoff.v1"},
    "release_authority": {"const": "fap-api-career-release-authority"},
    "request_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "content_agent_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "module": {"enum": ["identity", "definition", "salary", "geo", "ai-impact", "fit-personality", "risk", "compare-links", "faq", "page-meta"]},
    "publication_slugs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}}
  }
}
