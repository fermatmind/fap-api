[program:fap-queue-ops]
directory=__DEPLOY_PATH__/current/backend
command=/usr/bin/php artisan queue:work database --queue=ops --sleep=1 --tries=3 --timeout=120 --max-time=3600
process_name=%(program_name)s_%(process_num)02d
numprocs=1
autostart=true
autorestart=true
stopasgroup=true
killasgroup=true
user=www-data
redirect_stderr=true
stdout_logfile=__DEPLOY_PATH__/shared/backend/storage/logs/queue-ops.log
stopwaitsecs=360
