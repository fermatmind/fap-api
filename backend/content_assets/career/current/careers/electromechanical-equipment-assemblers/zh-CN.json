      "items": [
        {
          "availability": "available",
          "copy_key": "career.item.fermat-decision-card",
          "data": {
            "paragraphs": [
              "直接判断：机电设备装配工按图纸和规格装配、连接、测量、测试与记录机电组件。"
            ]
          },
          "id": "electromechanical-equipment-assemblers.quick-decision.fermat-decision-card.1",
          "source_refs": [
            "onet"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.fermat-decision-card",
          "data": {
            "paragraphs": [
              "适合信号：能耐心对准零件、核版本、测公差并保留异常。"
            ]
          },
          "id": "electromechanical-equipment-assemblers.quick-decision.fermat-decision-card.2",
          "source_refs": [
            "editorial"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.fermat-decision-card",
          "data": {
            "paragraphs": [
              "谨慎条件：若容易凭经验改图、跳过测量或忽略隔离，应先做纸面练习。"
            ]
          },
          "id": "electromechanical-equipment-assemblers.quick-decision.fermat-decision-card.3",
          "source_refs": [
            "editorial"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.fermat-decision-card",
          "data": {
            "paragraphs": [
              "安全试做只用四条虚构记录，不接电或操作真实设备。"
            ]
          },
          "id": "electromechanical-equipment-assemblers.quick-decision.fermat-decision-card.4",
          "source_refs": [
            "editorial"
          ],
          "type": "prose"
        }
      ]
    },
