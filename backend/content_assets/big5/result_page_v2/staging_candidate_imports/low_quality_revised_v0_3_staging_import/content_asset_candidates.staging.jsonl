{"applies_to":{"quality_status":["low_confidence","invalid","insufficient"],"scale_code":["BIG5_OCEAN"],"scope":["low_quality"]},"asset_id":"candidate_content_low_quality_should_soften_or_hide_when_low_quality_v0_3","asset_key":"low_quality_state.should_soften_or_hide_when_low_quality.v0_3","asset_kind":"content_asset","asset_layer":"L7_result_state","asset_type":"result_state","asset_version":"v0_3","avoid_when":[{"action":"suppress","field":"scale_code","operator":"not_equals","value":"BIG5_OCEAN"},{"action":"suppress","field":"scope","operator":"not_equals","value":"low_quality"}],"body_quality":{"body_chars":194,"cta_chars":15,"has_action_layer":true,"has_boundary_layer":true,"has_editorial_leakage":false,"has_quality_layer":true,"has_retest_layer":false,"has_state_layer":true,"conditional_low_quality_only":true,"normal_result_suppression_required":true,"max_sentence_length":41,"recalculated_by":"codex_low_quality_scientific_repair_01","rendered_preview_required":true,"sentence_count":6,"short_body_chars":22,"summary_chars":26,"template_risk":"low"},"body_zh":"低置信结果里，最需要放轻的是复杂组合、细分面向、长期画像、公开分享摘要和跨时间对比。它们不是完全不能看，而是不能被写成清晰、稳定、可外传的判断。尤其当报告涉及压力、关系、协作方式时，文字应从“你是什么样”转为“可以观察什么”。这能避免用户把暂时材料当成长期答案，也能避免他人看到简短摘要后产生过度解读。越是会影响他人判断的内容，越应保守处理。这类收窄应发生在系统层，而不是让用户自行猜测。","can_combine_with":["method_boundary_context","retest_guidance","safe_summary_context"],"cannot_combine_with":["strong_personality_claim","private_result_details","ranking_claim","high_stakes_language"],"copy_role":"conditional_degraded_state_user_visible_body_candidate","cta_zh":"把复杂解释收窄成可观察的问题。","dedupe_group":"low_quality_state.should_soften_or_hide_when_low_quality","fallback_allowed":false,"module_key":"module_10_method_privacy","production_use_allowed":false,"qa_status":"editorial_reviewed","reading_mode":["quick","standard","deep"],"ready_for_pilot":false,"ready_for_production":false,"ready_for_runtime":false,"render_surface":["result_page","pdf"],"repair_log_refs":[],"runtime_use":"staging_only","safety_le