            "items": {
                "type": "object"
            }
        },
        "parity": {
            "type": "object"
        },
        "authority": {
            "type": "object"
        },
        "runtime_observation": {
            "type": "object"
        },
        "public_funnel": {
            "type": "object"
        },
        "authority_runtime_separated": {
            "const": true
        },
        "redirect_aliases_in_public_set": {
            "const": false
        },
        "artifact_only": {
            "const": true
        },
        "read_only": {
            "const": true
        },
        "execution_allowed": {
            "const": false
        },
        "artifact_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
        }
    },
    "schema_hash": "b315e2bcdd571450c2e83c6473fead75869abfef2f904d0872ce7d9aa1de7242"
