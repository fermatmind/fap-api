      "id": "profile",
      "items": [
        {
          "availability": "available",
          "copy_key": "career.item.definition-block",
          "data": {
            "paragraphs": [
              "本页覆盖美国O*NET 25-1125.00高校历史教师，包括教学为主及教学研究并重岗位。"
            ]
          },
          "id": "history-teachers-postsecondary.profile.definition-block.1",
          "source_refs": [
            "onet-profile-25112500"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.definition-block",
          "data": {
            "paragraphs": [
              "投入包括课程目标、史料、研究文献、学生作品和院校要求。"
            ]
          },
          "id": "history-teachers-postsecondary.profile.definition-block.2",
          "source_refs": [
            "onet-profile-25112500"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.definition-block",
          "data": {
            "paragraphs": [
              "产出包括课程材料、讲授与讨论、作业评价、反馈、研究指导和学术成果。"
            ]
          },
          "id": "history-teachers-postsecondary.profile.definition-block.3",
          "source_refs": [
            "onet-profile-25112500"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.definition-block",
          "data": {
            "paragraphs": [
              "流程从选题与材料核验开始，经课程设计、教学、评价、反馈和修订。"
            ]
          },
          "id": "history-teachers-postsecondary.profile.definition-block.4",
          "source_refs": [
            "onet-profile-25112500"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.definition-block",
          "data": {
            "paragraphs": [
              "关键判断是史料是否可靠、解释是否有证据、评价标准是否一致。"
            ]
          },
          "id": "history-teachers-postsecondary.profile.definition-block.5",
          "source_refs": [
            "onet-profile-25112500"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.definition-block",
          "data": {
            "paragraphs": [
              "工作通常在高校环境，包含授课、办公时间、研究、会议和学生指导。"
            ]
          },
          "id": "history-teachers-postsecondary.profile.definition-block.6",
          "source_refs": [
            "onet-profile-25112500"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.definition-block",
          "data": {
            "paragraphs": [
              "数字工具的采用、权限与数据边界须按具体院校和岗位核对。"
            ]
          },
          "id": "history-teachers-postsecondary.profile.definition-block.7",
          "source_refs": [
            "editorial-history-guidance"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.definition-block",
          "data": {
            "paragraphs": [
              "协作对象包括学生、同学科教师、图书档案人员和院系管理人员。"
            ]
          },
          "id": "history-teachers-postsecondary.profile.definition-block.8",
          "source_refs": [
            "onet-profile-25112500"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.definition-block",
          "data": {
            "paragraphs": [
              "质量看引证可追溯、解释区分事实与推论、评价一致、反馈可操作。"
            ]
          },
          "id": "history-teachers-postsecondary.profile.definition-block.9",
          "source_refs": [
            "onet-profile-25112500"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.definition-block",
          "data": {
            "paragraphs": [
              "资格认定、成绩发布、学生数据和研究伦理按院校与所在地规则处理。"
            ]
          },
          "id": "history-teachers-postsecondary.profile.definition-block.10",
          "source_refs": [
            "editorial-history-guidance"
          ],
          "type": "prose"
        }
      ]
