{
  "schema_id": "seo.competitive_source_policy.v1",
  "schema_version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "policy_id", "policy_version", "source_id", "source_class", "registry_revision", "allowed_origins", "allowed_path_prefixes", "robots_review", "terms_review", "license_review", "reviewed_at", "expires_at", "max_validity_seconds", "collection_state", "prohibitions", "policy_hash"],
  "properties": {
    "version": {"const": "seo.competitive_source_policy.v1"}, "policy_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"},
    "policy_version": {"type": "integer", "minimum": 1}, "source_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "source_class": {"enum": ["fermatmind_public", "competitor_public"]}, "registry_revision": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "allowed_origins": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "pattern": "^https://[A-Za-z0-9.-]+$"}},
    "allowed_path_prefixes": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^/[A-Za-z0-9._~!$&'()*+,;=:@%/-]*$"}},
    "robots_review": {"const": "approved"}, "terms_review": {"const": "approved"}, "license_review": {"const": "public_structure_permitted"},
    "reviewed_at": {"type": "string", "format": "date-time"}, "expires_at": {"type": "string", "format": "date-time"},
    "max_validity_seconds": {"type": "integer", "minimum": 1, "maximum": 2592000}, "collection_state": {"enum": ["approved", "hold", "expired"]},
    "prohibitions": {"type": "object", "additionalProperties": false, "required": ["redirects", "non_https", "login", "paywall", "raw_html_retention", "competitor_snippet_retention", "arbitrary_mission_urls"], "properties": {"redirects": {"const": true}, "non_https": {"const": true}, "login": {"const": true}, "paywall": {"const": true}, "raw_html_retention": {"const": true}, "competitor_snippet_retention": {"const": true}, "arbitrary_mission_urls": {"const": true}}},
    "policy_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
