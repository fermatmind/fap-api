{
  "schema_id": "seo.competitive_source_policy.v3",
  "schema_version": "3.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "policy_id", "policy_version", "source_id", "source_class", "source_registry_revision", "exact_source_url", "exact_origin", "exact_path", "allowed_origins", "allowed_path_prefixes", "terms_url", "terms_url_hash", "terms_content_hash", "license_url", "license_url_hash", "license_content_hash", "robots_url", "robots_evidence_hash", "robots_decision", "terms_review", "license_review", "reviewed_at", "expires_at", "max_validity_seconds", "minimum_request_interval", "max_concurrency", "max_content_bytes", "connect_timeout_seconds", "request_timeout_seconds", "retention_scope", "collection_state", "prohibitions", "policy_hash"],
  "properties": {
    "version": {"const": "seo.competitive_source_policy.v3"},
    "policy_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"},
    "policy_version": {"const": 3},
    "source_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "source_class": {"enum": ["fermatmind_public", "competitor_public"]},
    "source_registry_revision": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "exact_source_url": {"type": "string", "pattern": "^https://[A-Za-z0-9.-]+/[A-Za-z0-9._~!$&'()*+,;=:@%/-]*$"},
    "exact_origin": {"type": "string", "pattern": "^https://[A-Za-z0-9.-]+$"},
    "exact_path": {"type": "string", "pattern": "^/[A-Za-z0-9._~!$&'()*+,;=:@%/-]*$"},
    "allowed_origins": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "pattern": "^https://[A-Za-z0-9.-]+$"}},
    "allowed_path_prefixes": {"type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "pattern": "^/[A-Za-z0-9._~!$&'()*+,;=:@%/-]*$"}},
    "terms_url": {"type": "string", "pattern": "^https://"},
    "terms_url_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "terms_content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "license_url": {"type": "string", "pattern": "^https://"},
    "license_url_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "license_content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "robots_url": {"type": "string", "pattern": "^https://"},
    "robots_evidence_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "robots_decision": {"const": "approved"},
    "terms_review": {"const": "approved"},
    "license_review": {"enum": ["first_party_authority", "public_structure_permitted"]},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "max_validity_seconds": {"type": "integer", "minimum": 1, "maximum": 2592000},
    "minimum_request_interval": {"type": "integer", "minimum": 1, "maximum": 30},
    "max_concurrency": {"const": 1},
    "max_content_bytes": {"type": "integer", "minimum": 1024, "maximum": 1048576},
    "connect_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3},
    "request_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 8},
    "retention_scope": {"const": ["url_hash", "content_hash", "structural_projection", "review_decision"]},
    "collection_state": {"const": "approved"},
    "prohibitions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["redirects", "non_https", "login", "paywall", "captcha", "raw_html_retention", "competitor_text_retention", "query_strings", "arbitrary_mission_urls"],
      "properties": {
        "redirects": {"const": true}, "non_https": {"const": true}, "login": {"const": true},
        "paywall": {"const": true}, "captcha": {"const": true}, "raw_html_retention": {"const": true},
        "competitor_text_retention": {"const": true}, "query_strings": {"const": true}, "arbitrary_mission_urls": {"const": true}
      }
    },
    "policy_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
