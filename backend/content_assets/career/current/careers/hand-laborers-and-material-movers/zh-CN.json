          "availability": "available",
          "copy_key": "career.item.faq-block",
          "data": {
            "entries": [
              {
                "answer": "核心工作包括读工单、移动货物、分拣、加固、贴标、记录件数、包装并检查损坏或泄漏。",
                "id": "hand-laborers-and-material-movers.faq.1",
                "question_key": "career.faq.hand-laborers-and-material-movers.daily-work",
                "source_refs": [
                  "onet"
                ]
              },
              {
                "answer": "人工搬运工以实际移动与保护材料为核心；收发库存文员管单据库存，称量记录岗位测量记录，建筑劳工和采掘助手服务特定现场，机械维护工修理设备。",
                "id": "hand-laborers-and-material-movers.faq.2",
                "question_key": "career.faq.hand-laborers-and-material-movers.role-comparison",
                "source_refs": [
                  "adj-construct",
                  "adj-extract",
                  "adj-maint",
                  "adj-ship",
                  "adj-weigh",
                  "onet"
                ]
              },
              {
                "answer": "适配证据来自能否核工单、保护货物、使用正确搬运方式、持续记录，并在重量或通道未知时停手。",
                "id": "hand-laborers-and-material-movers.faq.3",
                "question_key": "career.faq.hand-laborers-and-material-movers.fit",
                "source_refs": [
                  "editorial"
                ]
              },
              {
                "answer": "AI可辅助核对装运单、规划纸面顺序和提示缺失字段，但不能确认现场重量、重心、通道、吊具或人员位置。",
                "id": "hand-laborers-and-material-movers.faq.4",
                "question_key": "career.faq.hand-laborers-and-material-movers.ai-impact",
                "source_refs": [
                  "editorial"
                ]
              },
              {
                "answer": "人员必须现场核货物、容器、标签、通道、搬运工具和协同信号；工具不得替人指挥起吊或超越额定载荷。",
                "id": "hand-laborers-and-material-movers.faq.5",
                "question_key": "career.faq.hand-laborers-and-material-movers.human-control",
                "source_refs": [
                  "editorial"
                ]
              },
              {
                "answer": "国家统计局2025年行业和人员类别工资材料未建立与O*NET 53-7062.00一一对应的中国全国单职业工资分布。",
                "id": "hand-laborers-and-material-movers.faq.6",
                "question_key": "career.faq.hand-laborers-and-material-movers.china-pay",
                "source_refs": [
                  "nbs"
                ]
              },
              {
                "answer": "美国2025年精确职业数据：年薪中位数40,240美元，时薪中位数19.35美元。",
                "id": "hand-laborers-and-material-movers.faq.7",
                "question_key": "career.faq.hand-laborers-and-material-movers.us-pay",
                "source_refs": [
                  "wage"
                ]
              },
              {
                "answer": "入门证据应展示工单核对、货物分流、损坏记录、交接和停手边界，不用体力自信替代训练。",
                "id": "hand-laborers-and-material-movers.faq.8",
                "question_key": "career.faq.hand-laborers-and-material-movers.education-path",
                "source_refs": [
                  "editorial"
                ]
              },
              {
                "answer": "课程、工牌和岗位名称不自动授予车辆、起重、吊挂或特殊货物作业权限。",
                "id": "hand-laborers-and-material-movers.faq.9",
                "question_key": "career.faq.hand-laborers-and-material-movers.credentials",
                "source_refs": [
                  "editorial"
                ]
              },
              {
                "answer": "重量、重心、包装、标签、通道、人员位置或工具额定能力不清时不移动货物，保留现场并升级。",
                "id": "hand-laborers-and-material-movers.faq.10",
                "question_key": "career.faq.hand-laborers-and-material-movers.risk-boundary",
                "source_refs": [
                  "editorial"
                ]
              },
              {
                "answer": "美国BLS预计就业人数由2024年的2,988,900人增至2034年的3,033,100人，增长2%，同期年均空缺384,300个。",
                "id": "hand-laborers-and-material-movers.faq.11",
                "question_key": "career.faq.hand-laborers-and-material-movers.outlook-transition",
                "source_refs": [
                  "trend"
                ]
              },
              {
                "answer": "是否值得进入应由纸面装运单中的核对、分流、停手和交接质量决定，而不是只看体力。",
                "id": "hand-laborers-and-material-movers.faq.12",
                "question_key": "career.faq.hand-laborers-and-material-movers.career-worth",
                "source_refs": [
                  "editorial"
                ]
              }
            ]
          },
          "id": "hand-laborers-and-material-movers.sources.faq.1",
