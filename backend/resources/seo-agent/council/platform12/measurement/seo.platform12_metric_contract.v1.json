        "INCONCLUSIVE",
        "MEASUREMENT_BASELINE_HOLD",
        "RESTART_REQUIRED"
    ],
    "decision_rules": {
        "external_data_failure": {
            "state": "MEASUREMENT_HOLD",
            "denominator_policy": "RETAIN_ALL_PLANNED_OR_ELIGIBLE_UNITS",
