            "editorial"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.career-risk-cards",
          "data": {
            "paragraphs": [
              "样本选择偏差；建模前记录纳入排除规则和覆盖范围，关键缺口交项目负责人决定是否继续。"
            ]
          },
          "id": "economists.risk.career-risk-cards.2",
          "source_refs": [
            "editorial"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.career-risk-cards",
          "data": {
            "paragraphs": [
              "模型设定不稳；出报告前由分析者运行替代设定与敏感性检查，结论变化显著时升级独立审阅。"
            ]
          },
          "id": "economists.risk.career-risk-cards.3",
          "source_refs": [
            "editorial"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.career-risk-cards",
          "data": {
            "paragraphs": [
