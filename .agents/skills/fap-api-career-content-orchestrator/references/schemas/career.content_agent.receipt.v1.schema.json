{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fermatmind.com/schemas/career.content_agent.receipt.v1.schema.json",
  "title": "Career Content Agent receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "batch_id", "request_hash", "inventory_hash", "source_policy", "adapter_version", "batch_risk", "final_state", "gates", "artifact_hashes", "slug_results", "dimension_binding", "evidence_contract_versions", "dry_compile_status", "counts", "resources", "source_access_blockers", "manual_review", "lifecycle", "permissions", "write_counts"],
  "properties": {
    "contract_version": {"const": "career.content_agent.receipt.v1"},
    "batch_id": {"type": "string", "minLength": 1},
    "request_hash": {"$ref": "#/$defs/hash"},
    "inventory_hash": {"$ref": "#/$defs/hash"},
    "source_policy": {"type": "object", "additionalProperties": false, "required": ["version", "hash"], "properties": {"version": {"type": "string", "minLength": 1}, "hash": {"$ref": "#/$defs/hash"}}},
    "adapter_version": {"const": "career.research.compiler_evidence_adapter.v1"},
    "batch_risk": {"enum": ["standard", "regulated", "ymyl_high"]},
    "final_state": {"enum": ["ORCHESTRATED", "BLOCKED_INPUT", "BLOCKED_SOURCE_ACCESS", "BLOCKED_RESEARCH", "WARN_EDITORIAL", "BLOCKED_EDITORIAL", "BLOCKED_EVIDENCE", "BLOCKED_COMPILE", "MANUAL_REVIEW_REQUIRED", "BUDGET_EXHAUSTED"]},
    "gates": {
      "type": "array", "minItems": 0, "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["gate", "state", "input_hash", "output_hash"],
        "properties": {
          "gate": {"enum": ["research", "editorial", "evidence_adapter", "dry_compile", "orchestrator"]},
          "state": {"enum": ["PASS", "WARN", "BLOCKED", "MANUAL_REVIEW_REQUIRED", "BUDGET_EXHAUSTED"]},
          "input_hash": {"$ref": "#/$defs/hash"}, "output_hash": {"$ref": "#/$defs/hash"}
        }
      }
    },
    "artifact_hashes": {
      "type": "object", "additionalProperties": false,
      "required": ["research_candidate", "evidence_package", "dry_compile_candidate"],
      "properties": {"research_candidate": {"$ref": "#/$defs/nullableHash"}, "evidence_package": {"$ref": "#/$defs/nullableHash"}, "dry_compile_candidate": {"$ref": "#/$defs/nullableHash"}}
    },
    "slug_results": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["slug", "evidence_adapter_state", "evidence_package_digest", "dry_compile_state", "candidate_row_digest"],
        "properties": {
          "slug": {"type": "string", "minLength": 1},
          "evidence_adapter_state": {"enum": ["PASS", "BLOCKED", "NOT_RUN"]},
          "evidence_package_digest": {"$ref": "#/$defs/nullableHash"},
          "dry_compile_state": {"enum": ["PASS", "BLOCKED", "NOT_RUN"]},
          "candidate_row_digest": {"$ref": "#/$defs/nullableHash"}
        }
      }
    },
    "dimension_binding": {
      "type": "object", "additionalProperties": false, "required": ["claim_rows", "source_rows", "adapter_rows", "binding_digest", "mismatch_count"],
      "properties": {"claim_rows": {"type": "integer", "minimum": 0}, "source_rows": {"type": "integer", "minimum": 0}, "adapter_rows": {"type": "integer", "minimum": 0}, "binding_digest": {"$ref": "#/$defs/hash"}, "mismatch_count": {"type": "integer", "minimum": 0}}
    },
    "evidence_contract_versions": {"type": "array", "minItems": 0, "maxItems": 6, "uniqueItems": true, "items": {"enum": ["career.source_registry.v1", "career.claim_binding.v1", "career.evidence.authority.manifest.v1", "career.evidence.cohort.v1", "career.evidence.schema_profile_manifest.v1", "career.evidence.maturity_selection.v1"]}},
    "dry_compile_status": {"type": ["string", "null"], "enum": ["PASS_TEN_BLOCK_DRY_COMPILE", null]},
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": ["research_modules_per_slug", "producer_errors", "expired_sources", "unresolved", "unmapped", "sensitive_claims_without_tier_1_2", "dimension_mismatches", "auto_rewrite_attempts", "misrouted_unmapped_claims", "research_deterministic_rerun_pass", "evidence_contracts_passed", "loader_cohort_pass", "loader_single_slug_pass", "evidence_deterministic_rerun_pass", "required_compiler_claim_coverage_percent", "dry_compile_source_files", "dry_compile_locale_projections", "components_per_page", "dry_compile_blockers", "candidate_rows", "dry_compile_deterministic_rerun_pass"],
      "properties": {
        "research_modules_per_slug": {"type": "integer", "minimum": 0}, "producer_errors": {"type": "integer", "minimum": 0}, "expired_sources": {"type": "integer", "minimum": 0}, "unresolved": {"type": "integer", "minimum": 0}, "unmapped": {"type": "integer", "minimum": 0}, "sensitive_claims_without_tier_1_2": {"type": "integer", "minimum": 0}, "dimension_mismatches": {"type": "integer", "minimum": 0}, "auto_rewrite_attempts": {"type": "integer", "minimum": 0}, "misrouted_unmapped_claims": {"type": "integer", "minimum": 0}, "research_deterministic_rerun_pass": {"type": "boolean"}, "evidence_contracts_passed": {"type": "integer", "minimum": 0}, "loader_cohort_pass": {"type": "boolean"}, "loader_single_slug_pass": {"type": "boolean"}, "evidence_deterministic_rerun_pass": {"type": "boolean"}, "required_compiler_claim_coverage_percent": {"type": "number", "minimum": 0, "maximum": 100}, "dry_compile_source_files": {"type": "integer", "minimum": 0}, "dry_compile_locale_projections": {"type": "integer", "minimum": 0}, "components_per_page": {"type": "integer", "minimum": 0}, "dry_compile_blockers": {"type": "integer", "minimum": 0}, "candidate_rows": {"type": "integer", "minimum": 0}, "dry_compile_deterministic_rerun_pass": {"type": "boolean"}
      }
    },
    "resources": {
      "type": "object", "additionalProperties": false,
      "required": ["requests_total", "max_requests_for_any_source", "retries_for_any_request", "wall_time_seconds", "token_units", "external_spend", "paid_external_api_calls"],
      "properties": {"requests_total": {"type": "integer", "minimum": 0}, "max_requests_for_any_source": {"type": "integer", "minimum": 0}, "retries_for_any_request": {"type": "integer", "minimum": 0}, "wall_time_seconds": {"type": "number", "minimum": 0}, "token_units": {"$ref": "#/$defs/observation"}, "external_spend": {"$ref": "#/$defs/observation"}, "paid_external_api_calls": {"type": "integer", "minimum": 0}}
    },
    "source_access_blockers": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "manual_review": {"type": "object", "additionalProperties": false, "required": ["required", "status"], "properties": {"required": {"type": "boolean"}, "status": {"enum": ["not_required", "required_pending"]}}},
    "lifecycle": {
      "type": "object", "additionalProperties": false, "required": ["valid", "review_due_soon", "expired", "source_version_superseded", "supersession_bindings", "review_queue_count", "published_content_mutations"],
      "properties": {
        "valid": {"type": "integer", "minimum": 0}, "review_due_soon": {"type": "integer", "minimum": 0}, "expired": {"type": "integer", "minimum": 0}, "source_version_superseded": {"type": "integer", "minimum": 0}, "review_queue_count": {"type": "integer", "minimum": 0}, "published_content_mutations": {"const": 0},
        "supersession_bindings": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["source_key", "previous_version", "superseding_version", "registry_record_hash"], "properties": {"source_key": {"type": "string", "minLength": 1}, "previous_version": {"type": "string", "minLength": 1}, "superseding_version": {"type": "string", "minLength": 1}, "registry_record_hash": {"$ref": "#/$defs/hash"}}}}
      }
    },
    "permissions": {
      "type": "object", "additionalProperties": false, "required": ["publication_authorized", "current_replacement_authorized", "deploy_authorized", "search_submission_authorized"],
      "properties": {"publication_authorized": {"const": false}, "current_replacement_authorized": {"const": false}, "deploy_authorized": {"const": false}, "search_submission_authorized": {"const": false}}
    },
    "write_counts": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "current_package", "zh_master", "english_assets", "runtime_api", "cms", "database", "cache", "publisher", "deploy", "sitemap", "discoverability", "search_submission", "automation"],
      "properties": {"repository": {"const": 0}, "current_package": {"const": 0}, "zh_master": {"const": 0}, "english_assets": {"const": 0}, "runtime_api": {"const": 0}, "cms": {"const": 0}, "database": {"const": 0}, "cache": {"const": 0}, "publisher": {"const": 0}, "deploy": {"const": 0}, "sitemap": {"const": 0}, "discoverability": {"const": 0}, "search_submission": {"const": 0}, "automation": {"const": 0}}
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableHash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "observation": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["status", "value"], "properties": {"status": {"const": "known"}, "value": {"type": "number", "minimum": 0}}},
        {"type": "object", "additionalProperties": false, "required": ["status", "reason"], "properties": {"status": {"const": "unknown"}, "reason": {"type": "string", "minLength": 1}}}
      ]
    }
  }
}
