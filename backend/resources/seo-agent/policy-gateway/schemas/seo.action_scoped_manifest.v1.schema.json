{
  "schema_id": "seo.action_scoped_manifest.v1",
  "schema_version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "seo.action_scoped_manifest.v1"},
    "manifest_id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"},
    "manifest_version": {"const": "1.0.0"},
    "policy_registry_ref": {"type": "object", "additionalProperties": false, "properties": {"id": {"type": "string"}, "version": {"type": "string"}, "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "required": ["id", "version", "hash"]},
    "role_id": {"type": "string"},
    "mission_type": {"type": "string"},
    "capability_id": {"type": "string"},
    "target_environment": {"enum": ["testing", "staging", "production"]},
    "family": {"type": "string"},
    "locale": {"type": "string"},
    "action": {"type": "string"},
    "allowed_fields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "forbidden_fields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "autonomy": {"enum": ["L0", "L1", "L2", "L3", "L4"]},
    "max_urls": {"type": "integer", "minimum": 1},
    "shared_layer_allowed": {"type": "boolean"},
    "evidence_threshold": {"type": "object", "additionalProperties": false, "properties": {"minimum_bundle_count": {"type": "integer", "minimum": 1}, "required_status": {"const": "READY"}}, "required": ["minimum_bundle_count", "required_status"]},
    "rollback_unit": {"enum": ["exact_url", "exact_family_locale_revision"]},
    "approval": {"type": "object", "additionalProperties": false, "properties": {"surface_id": {"type": "string"}, "review_state": {"enum": ["approved", "pending", "rejected", "unknown"]}, "production_execution_separate": {"const": true}}, "required": ["surface_id", "review_state", "production_execution_separate"]},
    "authority_revision": {"type": "string", "minLength": 1},
    "canary_stage": {"type": "string", "minLength": 1},
    "expiry": {"type": "object", "additionalProperties": false, "properties": {"not_before": {"type": "string", "format": "date-time"}, "expires_at": {"type": "string", "format": "date-time"}}, "required": ["not_before", "expires_at"]},
    "revocation": {"type": "object", "additionalProperties": false, "properties": {"registry_id": {"const": "seo.manifest_revocation_registry"}, "registry_version": {"const": "1.0.0"}}, "required": ["registry_id", "registry_version"]},
    "manifest_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "signature": {"type": "object", "additionalProperties": false, "properties": {"algorithm": {"const": "Ed25519"}, "key_id": {"type": "string"}, "value": {"type": "string"}}, "required": ["algorithm", "key_id", "value"]}
  },
  "required": ["schema_version", "manifest_id", "manifest_version", "policy_registry_ref", "role_id", "mission_type", "capability_id", "target_environment", "family", "locale", "action", "allowed_fields", "forbidden_fields", "autonomy", "max_urls", "shared_layer_allowed", "evidence_threshold", "rollback_unit", "approval", "authority_revision", "canary_stage", "expiry", "revocation", "manifest_hash", "signature"]
}
