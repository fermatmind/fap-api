{"asset_id":"candidate_content_method_boundary_v0_5_04","asset_key":"candidate.method_boundary.thirty_facets_inference.v0_5","asset_version":"v0_5","asset_type":"method_boundary","asset_layer":"L0_governance","module_key":"module_10_method_privacy","section_key":"method_privacy","slot_key":"module_10_method_privacy.method.facet_method","copy_role":"user_visible_method_boundary_candidate","reading_mode":["standard","deep"],"title_zh":"细分面向解释差异，不单独定论","body_zh":"五个大维度下面有更细的观察面向。它们能解释为什么同样是尽责性，有人更体现为条理和计划，有人更体现为责任感、持续投入或谨慎决策。细分面向的价值，是把宽泛维度拆开看；它的限制，是信号更细、误差也更容易被放大。一个细分面向有共鸣，说明它值得结合生活场景观察，不说明它已经证明了能力、关系质量或长期结果。","short_body_zh":"细分面向能解释差异，但仍是观察线索，不是独立结论。","cta_zh":"遇到有共鸣的细分解释，写下一个真实场景；没有共鸣的部分先放进待观察。","applies_to":{"scale_code":["BIG5_OCEAN"],"candidate_stage":["method_boundary_v0_5_normalized"],"target_registry_key":["method_registry"],"target_module":["module_10_method_privacy"],"selection_scope":["facet_inference_boundary"],"candidate_replaces":["asset.module_10_method_privacy.method_registry.facet_method.v0_3"],"original_reading_modes":["standard","deep"]},"avoid_when":[{"field":"runtime_use","operator":"not_equals","value":"staging_only","action":"block_runtime_use"},{"field":"production_use_allowed","operator":"not_equals","value":false,"action":"block_production_use"}],"can_combine_with":["method_registry"],"cannot_combine_with":["runtime_use","production_use","frontend_copy"],"dedupe_group":"method_boundary_v0_5.module_10_method_privacy.method.facet_method","selection_priority":91,"selection_specificity":10,"fallback_allowed":false,"render_surface":[],"body_quality":{"body_chars":148,"sentence_count":4,"max_sentence_length":46,"has_method_layer":true,"has_boundary_layer":false,"has_action_layer":true,"has_privacy_layer":false,"has_editorial_leakage":false,"recalculated_by":"codex_method_boundary_scientific_repair_01"},"safety_tags":["method_boundary","human_reviewed_candidate","staging_only","not_runtime","no_frontend_copy","no_production_use"],"qa_status":"safety