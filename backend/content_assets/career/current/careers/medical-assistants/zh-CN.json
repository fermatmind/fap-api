      "copy_key": "career.block.fit",
      "id": "fit",
      "items": [
        {
          "availability": "available",
          "copy_key": "career.item.riasec-fit-block",
          "data": {
            "paragraphs": [
              "先看是否能耐心核对患者身份与记录字段。"
            ]
          },
          "id": "medical-assistants.fit.riasec-fit-block.1",
          "source_refs": [
            "editorial-medical-guidance"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.riasec-fit-block",
          "data": {
            "paragraphs": [
              "任务适配表现为能在行政与患者接触任务间准确切换。"
            ]
          },
          "id": "medical-assistants.fit.riasec-fit-block.2",
          "source_refs": [
            "editorial-medical-guidance"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.riasec-fit-block",
          "data": {
            "paragraphs": [
              "判断适配表现为发现不一致、缺失或权限不清时停止升级。"
            ]
          },
          "id": "medical-assistants.fit.riasec-fit-block.3",
          "source_refs": [
            "editorial-medical-guidance"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.riasec-fit-block",
          "data": {
            "paragraphs": [
              "交付适配表现为记录有时间、单位、来源和下一责任人。"
            ]
          },
          "id": "medical-assistants.fit.riasec-fit-block.4",
          "source_refs": [
            "editorial-medical-guidance"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.riasec-fit-block",
          "data": {
            "paragraphs": [
              "协作适配表现为能向患者与临床团队清楚传递信息。"
            ]
          },
          "id": "medical-assistants.fit.riasec-fit-block.5",
          "source_refs": [
            "editorial-medical-guidance"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.riasec-fit-block",
          "data": {
            "paragraphs": [
              "学习适配表现为持续掌握术语、流程、隐私和获授权技能。"
            ]
          },
          "id": "medical-assistants.fit.riasec-fit-block.6",
          "source_refs": [
            "editorial-medical-guidance"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.riasec-fit-block",
          "data": {
            "paragraphs": [
              "消耗点可能来自患者压力、站立、轮班、重复记录和高频切换。"
            ]
          },
          "id": "medical-assistants.fit.riasec-fit-block.7",
          "source_refs": [
            "editorial-medical-guidance"
          ],
          "type": "prose"
        },
