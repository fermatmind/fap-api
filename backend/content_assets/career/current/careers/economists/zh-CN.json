            ]
          },
          "id": "economists.risk.career-risk-cards.4",
          "source_refs": [
            "editorial"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.career-risk-cards",
          "data": {
            "paragraphs": [
