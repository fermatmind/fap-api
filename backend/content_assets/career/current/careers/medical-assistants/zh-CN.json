      "items": [
        {
          "availability": "available",
          "copy_key": "career.item.ai-impact-table",
          "data": {
            "paragraphs": [
              "数字工具可协助整理预约、表单和记录候选内容。"
            ]
          },
          "id": "medical-assistants.ai-impact.ai-impact-table.1",
          "source_refs": [
            "editorial-medical-guidance"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.ai-impact-table",
          "data": {
            "paragraphs": [
              "任何摘要都必须追回患者身份和原始记录。"
            ]
          },
          "id": "medical-assistants.ai-impact.ai-impact-table.2",
          "source_refs": [
            "editorial-medical-guidance"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.ai-impact-table",
          "data": {
            "paragraphs": [
              "缺失字段不能由工具猜补，保持未知并升级。"
            ]
          },
          "id": "medical-assistants.ai-impact.ai-impact-table.3",
          "source_refs": [
            "editorial-medical-guidance"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.ai-impact-table",
          "data": {
            "paragraphs": [
              "州法范围、机构权限和医师指示须人工核对。"
            ]
          },
          "id": "medical-assistants.ai-impact.ai-impact-table.4",
          "source_refs": [
            "editorial-medical-guidance"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.ai-impact-table",
          "data": {
            "paragraphs": [
              "诊断、治疗、给药或检验解释不能交给本页工具建议。"
            ]
          },
          "id": "medical-assistants.ai-impact.ai-impact-table.5",
          "source_refs": [
            "editorial-medical-guidance"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.ai-impact-table",
          "data": {
            "paragraphs": [
              "试用只用虚构数据，记录版本、修改、误报和漏报。"
            ]
          },
          "id": "medical-assistants.ai-impact.ai-impact-table.6",
          "source_refs": [
            "editorial-medical-guidance"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.ai-impact-table",
          "data": {
            "paragraphs": [
              "效果评价同时看身份错误、遗漏、返工与交接质量。"
            ]
          },
          "id": "medical-assistants.ai-impact.ai-impact-table.7",
          "source_refs": [
            "editorial-medical-guidance"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.ai-impact-table",
          "data": {
            "paragraphs": [
              "任务辅助能力不能直接推出岗位数量变化。"
            ]
          },
          "id": "medical-assistants.ai-impact.ai-impact-table.8",
          "source_refs": [
            "editorial-medical-guidance"
          ],
          "type": "prose"
        }
      ]
