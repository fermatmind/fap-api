      "id": "profile",
      "items": [
        {
          "availability": "available",
          "copy_key": "career.item.definition-block",
          "data": {
            "paragraphs": [
              "职业定义：规划、协调、修订或编辑书面材料，并可能审阅出版提案和草稿。"
            ]
          },
          "id": "editors.profile.definition-block.1",
          "source_refs": [
            "onet-details"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.responsibilities-block",
          "data": {
            "entries": [
              "核事实、日期和统计并保留来源。",
              "纠正语言错误、改写可读性和结构。",
              "发展选题、协调作者、版面与出版进度。"
            ]
          },
          "id": "editors.profile.responsibilities-block.1",
          "source_refs": [
            "onet-details"
          ],
          "type": "list"
        },
        {
          "availability": "available",
          "copy_key": "career.item.responsibilities-block",
          "data": {
            "entries": [
              "输入：稿件、简报、来源、风格规则和发布要求。",
              "处理：事实核查、结构与语言编辑、反馈、版本控制。",
              "输出：带修订与说明的稿件、核查表和审批版本。"
            ]
          },
          "id": "editors.profile.responsibilities-block.2",
          "source_refs": [
            "onet-details"
          ],
          "type": "list"
        },
        {
          "availability": "available",
          "copy_key": "career.item.responsibilities-block",
          "data": {
            "entries": [
              "先确认受众、目的、来源与截止期。",
              "区分事实错误、风格选择和作者意图。",
              "发布前核版本、权限、事实和最终责任人。"
            ]
          },
          "id": "editors.profile.responsibilities-block.3",
          "source_refs": [
            "onet-details"
          ],
          "type": "list"
        },
        {
          "availability": "available",
          "copy_key": "career.item.work-context-block",
          "data": {
            "paragraphs": [
              "BLS列出纠错、改写、核事实、评估投稿、协作作者、分配版面和批准终稿。"
            ]
          },
          "id": "editors.profile.work-context-block.1",
          "source_refs": [
            "bls-work"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.work-context-block",
          "data": {
            "paragraphs": [
              "工作常在办公室或远程进行，多项目和截止期会带来压力。"
            ]
          },
          "id": "editors.profile.work-context-block.2",
          "source_refs": [
