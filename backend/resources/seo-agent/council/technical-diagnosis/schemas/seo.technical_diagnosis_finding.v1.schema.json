{
  "schema_id": "seo.technical_diagnosis_finding.v1",
  "schema_version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["finding_id", "finding_version", "detector_code", "page_family", "locale", "affected_scope", "evidence_refs", "evidence_state", "authority_revision", "runtime_revision", "deployment_revision", "severity", "verified_facts", "root_cause_hypotheses", "confidence", "shared_layer_impact", "blast_radius", "recommended_owner", "recommended_path", "acceptance_checks", "evidence_gap", "hold_reason", "discovery_decision", "execution_allowed", "write_permission", "search_submission_allowed"],
  "properties": {
    "finding_id": {"type": "string"},
    "finding_version": {"const": 1},
    "detector_code": {"type": "string"},
    "page_family": {"type": "string"},
    "locale": {"type": "string"},
    "affected_scope": {"type": "object"},
    "evidence_refs": {"type": "array"},
    "evidence_state": {"enum": ["verified_fact", "supported_hypothesis", "unverified_hypothesis", "unknown", "blocked"]},
    "authority_revision": {"type": "string"},
    "runtime_revision": {"type": "string"},
    "deployment_revision": {"type": "string"},
    "severity": {"enum": ["P0", "P1", "P2", "P3", "HOLD"]},
    "verified_facts": {"type": "array"},
    "root_cause_hypotheses": {"type": "array"},
    "confidence": {"enum": ["high", "medium", "low", "insufficient"]},
    "shared_layer_impact": {"type": "boolean"},
    "blast_radius": {"type": "object"},
    "recommended_owner": {"type": "string"},
    "recommended_path": {"type": "object"},
    "acceptance_checks": {"type": "array"},
    "evidence_gap": {"type": ["object", "null"]},
    "hold_reason": {"type": ["string", "null"]},
    "discovery_decision": {"enum": ["ALLOW_DISCOVERY_REVIEW", "HOLD_DISCOVERY"]},
    "execution_allowed": {"const": false},
    "write_permission": {"const": false},
    "search_submission_allowed": {"const": false}
  }
}
