    {
      "availability": "available",
      "content_state": "enhanced",
      "copy_key": "career.block.ai-impact",
      "id": "ai-impact",
      "items": [
        {
          "availability": "available",
          "copy_key": "career.item.ai-impact-table",
          "data": {
            "paragraphs": [
              "数字工具可协助生成例题、材料和反馈草稿。"
            ]
          },
          "id": "middle-school-teachers.ai-impact.ai-impact-table.1",
          "source_refs": [
            "editorial-middle"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.ai-impact-table",
          "data": {
            "paragraphs": [
              "草稿中的事实、难度和答案必须由教师核验。"
            ]
          },
          "id": "middle-school-teachers.ai-impact.ai-impact-table.2",
          "source_refs": [
            "editorial-middle"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.ai-impact-table",
          "data": {
            "paragraphs": [
              "不得把真实学生敏感资料输入未经授权的工具。"
            ]
          },
          "id": "middle-school-teachers.ai-impact.ai-impact-table.3",
          "source_refs": [
            "editorial-middle"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.ai-impact-table",
          "data": {
            "paragraphs": [
              "自动评分不能代替教师对证据和公平性的判断。"
            ]
          },
          "id": "middle-school-teachers.ai-impact.ai-impact-table.4",
          "source_refs": [
            "editorial-middle"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.ai-impact-table",
          "data": {
            "paragraphs": [
              "缺少依据的评价保持未知，不给学生贴标签。"
            ]
          },
          "id": "middle-school-teachers.ai-impact.ai-impact-table.5",
          "source_refs": [
            "editorial-middle"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.ai-impact-table",
          "data": {
            "paragraphs": [
              "试用工具应记录版本、修改和失败案例。"
            ]
          },
          "id": "middle-school-teachers.ai-impact.ai-impact-table.6",
          "source_refs": [
            "editorial-middle"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.ai-impact-table",
          "data": {
            "paragraphs": [
              "效果要看学习证据、偏差、返工与教师负担。"
            ]
          },
          "id": "middle-school-teachers.ai-impact.ai-impact-table.7",
          "source_refs": [
            "editorial-middle"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.ai-impact-table",
          "data": {
            "paragraphs": [
              "技术能力不能直接推导教师岗位数量。"
            ]
          },
          "id": "middle-school-teachers.ai-impact.ai-impact-table.8",
          "source_refs": [
            "editorial-middle"
          ],
          "type": "prose"
        }
      ]
