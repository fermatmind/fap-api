{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.fermatmind.com/schemas/article-cover-replacement.v1.json",
  "title": "FermatMind bilingual article cover replacement manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "batch_id", "groups"],
  "properties": {
    "schema_version": { "const": "article-cover-replacement.v1" },
    "batch_id": { "type": "string", "minLength": 1, "maxLength": 120 },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/group" }
    }
  },
  "$defs": {
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["translation_group_id", "slug", "source_image", "asset_key", "allow_ensure_seo_meta_baseline", "locales"],
      "properties": {
        "translation_group_id": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "source_image": { "type": "string", "pattern": "^/" },
        "asset_key": { "type": "string", "pattern": "^article\\.[a-z0-9][a-z0-9.-]*\\.v[0-9]+$" },
        "allow_ensure_seo_meta_baseline": { "type": "boolean" },
        "locales": {
          "type": "object",
          "additionalProperties": false,
          "required": ["zh-CN", "en"],
          "properties": {
            "zh-CN": { "$ref": "#/$defs/locale" },
            "en": { "$ref": "#/$defs/locale" }
          }
        }
      }
    },
    "locale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["article_id", "alt", "robots", "is_indexable", "sitemap_eligible", "llms_eligible"],
      "properties": {
        "article_id": { "type": "integer", "minimum": 1 },
        "alt": { "type": "string", "minLength": 1, "maxLength": 255 },
        "canonical": { "type": "string", "format": "uri", "pattern": "^https://fermatmind\\.com/" },
        "robots": { "enum": ["index,follow", "noindex,nofollow"] },
        "is_indexable": { "type": "boolean" },
        "sitemap_eligible": { "type": "boolean" },
        "llms_eligible": { "type": "boolean" }
      }
    }
  }
}
