{
  "schema_id": "seo.policy_decision.v1",
  "schema_version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "seo.policy_decision.v1"},
    "decision_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "decision_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "stage": {"enum": ["admission", "execution"]},
    "decision": {"enum": ["HOLD", "DENY"]},
    "reason_codes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "policy_registry_id": {"const": "fermatmind.seo.policy_gateway_registry"},
    "policy_registry_version": {"const": "1.0.0"},
    "policy_registry_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "effective_role_id": {"type": "string"},
    "effective_scope": {"type": "object", "additionalProperties": false, "properties": {"family": {"type": "string"}, "locale": {"type": "string"}, "action": {"type": ["string", "null"]}}, "required": ["family", "locale", "action"]},
    "execution_allowed": {"const": false},
    "write_allowed": {"const": false},
    "model_invocation": {"const": false},
    "tool_invocation": {"const": false},
    "egress_allowed": {"const": false},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "negative_guarantees": {"type": "object", "additionalProperties": false, "properties": {"production_allow": {"const": false}, "business_write": {"const": false}, "cms_write": {"const": false}, "url_truth_write": {"const": false}, "search_submission": {"const": false}, "untrusted_value_echo": {"const": false}}, "required": ["production_allow", "business_write", "cms_write", "url_truth_write", "search_submission", "untrusted_value_echo"]}
  },
  "required": ["schema_version", "decision_id", "decision_hash", "stage", "decision", "reason_codes", "policy_registry_id", "policy_registry_version", "policy_registry_hash", "effective_role_id", "effective_scope", "execution_allowed", "write_allowed", "model_invocation", "tool_invocation", "egress_allowed", "evaluated_at", "negative_guarantees"]
}
