        "contract_change": {
            "new_version_required": true,
            "new_hash_required": true,
            "restart_scope": "ALL_AFFECTED_METRICS"
        },
        "restart_triggers": [
            "PRIVATE_DATA_LEAK",
            "AUTHORITY_VIOLATION",
            "UNAUTHORIZED_EXECUTION",
            "WRONG_CANONICAL_OR_NOINDEX",
            "SCALING_AFTER_GUARDRAIL_FAILURE",
