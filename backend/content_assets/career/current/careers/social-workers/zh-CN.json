          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.responsibilities-block",
          "data": {
            "entries": [
              "O*NET明确“All Other”类别特征范围很宽。"
            ]
          },
          "id": "social-workers.profile.responsibilities-block.1",
          "source_refs": [
            "onet-umbrella"
          ],
          "type": "list"
        },
        {
          "availability": "available",
          "copy_key": "career.item.responsibilities-block",
          "data": {
            "entries": [
              "O*NET明确该标题没有统一职业任务数据。"
            ]
          },
          "id": "social-workers.profile.responsibilities-block.2",
          "source_refs": [
            "onet-umbrella"
          ],
          "type": "list"
        },
        {
          "availability": "available",
          "copy_key": "career.item.responsibilities-block",
          "data": {
            "entries": [
              "因此不能给整个类别编造统一的咨询、评估、转介或临床职责。"
            ]
          },
          "id": "social-workers.profile.responsibilities-block.3",
          "source_refs": [
            "onet-umbrella"
          ],
          "type": "list"
        },
        {
          "availability": "available",
          "copy_key": "career.item.work-context-block",
          "data": {
            "paragraphs": [
              "具体岗位首先核服务对象和主要问题。"
            ]
          },
          "id": "social-workers.profile.work-context-block.1",
          "source_refs": [
            "editorial"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.work-context-block",
          "data": {
            "paragraphs": [
              "再核服务/产出、机构场景和记录协作。"
            ]
          },
          "id": "social-workers.profile.work-context-block.2",
          "source_refs": [
            "editorial"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.onet-structured-fields-block",
          "data": {
            "paragraphs": [
              "再核监督关系、资格与授权边界。"
            ]
          },
          "id": "social-workers.profile.onet-structured-fields-block.1",
          "source_refs": [
            "editorial"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.career-quick-answers-block",
          "data": {
            "paragraphs": [
              "同一头衔在政府、卫生社会援助或其他行业可对应不同工作。"
            ]
          },
          "id": "social-workers.profile.career-quick-answers-block.1",
          "source_refs": [
            "editorial"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.career-quick-answers-block",
          "data": {
            "paragraphs": [
              "质量判断只能落到具体岗位说明、机构规则和监督链。"
            ]
          },
          "id": "social-workers.profile.career-quick-answers-block.2",
          "source_refs": [
            "editorial"
          ],
          "type": "prose"
        },
        {
          "availability": "available",
          "copy_key": "career.item.definition-block",
          "data": {
            "paragraphs": [
              "一句话：这是一类待拆分的职业桶，不是一套固定日常。"
            ]
          },
          "id": "social-workers.profile.definition-block.2",
          "source_refs": [
            "editorial"
          ],
          "type": "prose"
        }
      ]
